# Default provider. Options: cli-proxy, deepseek, minimax, moonshot, openrouter, qwen
LLM_PROVIDER=cli-proxy

# CLIProxyAPI local proxy
LLM_API_KEY=your-proxy-api-key
LLM_BASE_URL=http://localhost:8317/v1

# Optional providers
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
